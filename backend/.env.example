ENVIRONMENT=dev
GCP_PROJECT_ID=shifahealthai
GCP_REGION=us-central1
CORS_ALLOW_ORIGINS=["http://localhost:5173"]
INTERNAL_API_KEY=dev-internal-key-change-me
AGENT_SERVICE_BASE_URL=http://localhost:8001
PUBSUB_TOPIC=shifahealth-events

# Only meaningful when deployed (see docs/architecture.md's "two HTTP relationships" section) -
# leave blank locally; a Bearer token never arrives in local dev, so these are never consulted.
PUBLIC_BASE_URL=
AGENTS_SERVICE_ACCOUNT_EMAIL=
